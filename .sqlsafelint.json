{
  "schema": {
    "driver": "ddl",
    "dsn": "",
    "ddl": "schema.sql",
    "search_path": ["public"],
    "cache_ttl": 300,
    "cache_path": ".sqlsafelint.schema.json"
  },
  "scan": {
    "workspace": ".",
    "include": ["**/*.go"],
    "exclude": ["**/vendor/**", "**/.git/**"],
    "workers": 0,
    "timeout_ms": 500
  },
  "rules": {
    "enable": ["GORM1001", "GORM1002"],
    "disable": [],
    "plugins": []
  },
  "output": {
    "json": true,
    "sarif": false
  }
}
